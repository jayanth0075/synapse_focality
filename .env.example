# ==============================================================================
# SYNAPSE Organizational Intelligence Platform Configuration
# ==============================================================================

# Environment
SYNAPSE_ENV=development
SYNAPSE_DB_PATH=data_storage/synapse.db
DEFAULT_TENANT_ID=tenant-artisan-corp-01

# Neo4j Aura Graph Database (Cloud Instance)
# Create a free database at https://console.neo4j.io
# Connection URI format: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=neo4j+s://your-aura-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_aura_password_here
NEO4J_DATABASE=neo4j

# LLM Providers (Optional - Local deterministic fallback active if unset)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Workspace OAuth Connectors (Optional - Test fixtures active if unset)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/sources/google/callback

# Server Configuration
HOST=0.0.0.0
PORT=8000
